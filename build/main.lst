   2:Core/Src/main.c **** /**
   3:Core/Src/main.c ****   ******************************************************************************
   4:Core/Src/main.c ****   * @file           : main.c
   5:Core/Src/main.c ****   * @brief          : Main program body - LED Blink Test
   6:Core/Src/main.c ****   * @description    : Blinks onboard LED on PC13 (WeAct Black Pill STM32F401CCU6)
   7:Core/Src/main.c ****   *                   LED is ACTIVE LOW: GPIO_PIN_RESET = ON, GPIO_PIN_SET = OFF
   8:Core/Src/main.c ****   *                   Blink period: 1 second (500ms ON, 500ms OFF)
   9:Core/Src/main.c ****   ******************************************************************************
  10:Core/Src/main.c ****   */
  11:Core/Src/main.c **** /* USER CODE END Header */
  12:Core/Src/main.c **** 
  13:Core/Src/main.c **** /* Includes ------------------------------------------------------------------*/
  14:Core/Src/main.c **** #include "main.h"
  15:Core/Src/main.c **** 
  16:Core/Src/main.c **** /* Private variables ---------------------------------------------------------*/
  17:Core/Src/main.c **** 
  18:Core/Src/main.c **** /* Private function prototypes -----------------------------------------------*/
  19:Core/Src/main.c **** void SystemClock_Config(void);
  20:Core/Src/main.c **** static void MX_GPIO_Init(void);
  21:Core/Src/main.c **** 
  22:Core/Src/main.c **** /* Private user code ---------------------------------------------------------*/
  23:Core/Src/main.c **** 
  24:Core/Src/main.c **** /**
  25:Core/Src/main.c ****   * @brief  The application entry point.
  26:Core/Src/main.c ****   * @retval int
  27:Core/Src/main.c ****   */
  28:Core/Src/main.c **** int main(void)
  29:Core/Src/main.c **** {
  30:Core/Src/main.c ****   /* MCU Configuration--------------------------------------------------------*/
  31:Core/Src/main.c **** 
ARM GAS  C:\Users\Admin\AppData\Local\Temp\ccGVrvTu.s 			page 2


  32:Core/Src/main.c ****   /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  33:Core/Src/main.c ****   HAL_Init();
  34:Core/Src/main.c **** 
  35:Core/Src/main.c ****   /* Configure the system clock to 84 MHz using HSE 25MHz + PLL */
  36:Core/Src/main.c ****   SystemClock_Config();
  37:Core/Src/main.c **** 
  38:Core/Src/main.c ****   /* Initialize all configured peripherals */
  39:Core/Src/main.c ****   MX_GPIO_Init();
  40:Core/Src/main.c **** 
  41:Core/Src/main.c ****   /* Infinite loop */
  42:Core/Src/main.c ****   while (1)
  43:Core/Src/main.c ****   {
  44:Core/Src/main.c ****     /*
  45:Core/Src/main.c ****      * LED is Active LOW on WeAct Black Pill:
  46:Core/Src/main.c ****      * GPIO_PIN_RESET (0) = LED ON  (cathode pulled low, current flows)
  47:Core/Src/main.c ****      * GPIO_PIN_SET   (1) = LED OFF (cathode high, no current)
  48:Core/Src/main.c ****      */
  49:Core/Src/main.c **** 
  50:Core/Src/main.c ****     /* LED ON */
  51:Core/Src/main.c ****     HAL_GPIO_WritePin(LED_ONBOARD_GPIO_Port, LED_ONBOARD_Pin, GPIO_PIN_RESET);
  52:Core/Src/main.c ****     HAL_Delay(500);
  53:Core/Src/main.c **** 
  54:Core/Src/main.c ****     /* LED OFF */
  55:Core/Src/main.c ****     HAL_GPIO_WritePin(LED_ONBOARD_GPIO_Port, LED_ONBOARD_Pin, GPIO_PIN_SET);
  56:Core/Src/main.c ****     HAL_Delay(500);
  57:Core/Src/main.c ****   }
  58:Core/Src/main.c **** }
  59:Core/Src/main.c **** 
  60:Core/Src/main.c **** /**
  61:Core/Src/main.c ****   * @brief System Clock Configuration
  62:Core/Src/main.c ****   * @detail Configures the system clock as follows:
  63:Core/Src/main.c ****   *         - HSE = 25 MHz (external crystal on WeAct Black Pill)
  64:Core/Src/main.c ****   *         - PLL Source = HSE
  65:Core/Src/main.c ****   *         - PLLM = 25 (VCO input = 1 MHz)
  66:Core/Src/main.c ****   *         - PLLN = 336 (VCO output = 336 MHz)
  67:Core/Src/main.c ****   *         - PLLP = 4 (SYSCLK = 84 MHz)
  68:Core/Src/main.c ****   *         - PLLQ = 7 (USB = 48 MHz)
  69:Core/Src/main.c ****   *         - AHB Prescaler = 1 (HCLK = 84 MHz)
  70:Core/Src/main.c ****   *         - APB1 Prescaler = 2 (PCLK1 = 42 MHz)
  71:Core/Src/main.c ****   *         - APB2 Prescaler = 1 (PCLK2 = 84 MHz)
  72:Core/Src/main.c ****   *         - Flash Latency = 2 WS (for 84 MHz @ 3.3V)
  73:Core/Src/main.c ****   * @retval None
  74:Core/Src/main.c ****   */
  75:Core/Src/main.c **** void SystemClock_Config(void)
  76:Core/Src/main.c **** {
  77:Core/Src/main.c ****   RCC_OscInitTypeDef RCC_OscInitStruct = {0};
