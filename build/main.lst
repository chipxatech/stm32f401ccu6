  82:Core/Src/main.c ****   __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE2);
  83:Core/Src/main.c **** 
  84:Core/Src/main.c ****   /** Initializes the RCC Oscillators according to the specified parameters
  85:Core/Src/main.c ****   * in the RCC_OscInitTypeDef structure.
  86:Core/Src/main.c ****   * HSE = 25MHz external crystal on WeAct Black Pill board
  87:Core/Src/main.c ****   */
  88:Core/Src/main.c ****   RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
ARM GAS  C:\Users\Admin\AppData\Local\Temp\ccGVrvTu.s 			page 3


